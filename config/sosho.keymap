//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

/* Keep the two hold-tap behaviors in the Studio behavior registry even when
 * the compiled default keymap does not reference them.  This is required for
 * Web/ZMK Studio to write a new tap/hold binding over RPC. */
#define ZMK_BEHAVIORS_KEEP_MT
#define ZMK_BEHAVIORS_KEEP_LT
#define ZMK_BEHAVIORS_OMIT_NONE
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        sosho_controls: sosho_controls {
            compatible = "sosho,behavior-controls";
            #binding-cells = <1>;
        };
        sosho_wheel: sosho_wheel {
            compatible = "sosho,behavior-wheel";
            #binding-cells = <1>;
        };
        sosho_runtime_macro: sosho_runtime_macro {
            compatible = "sosho,behavior-runtime-macro";
            #binding-cells = <1>;
        };
        ec_ms_l: ec_ms_h {
            compatible = "sosho,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "sosho,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/ {
    combos {
        compatible = "zmk,combos";
        //左クリックのコンボ 19はJのキー 20はKのキーに相当します。
        combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

        //右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

        //ホイールクリックのコンボ 19 J 21 L
        combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };
    };
};

/ {
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp TAB    &kp Q   &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
            &kp LCTRL  &kp A   &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SQT   &kp ENTER
            &kp LSHFT  &kp Z   &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH &kp LSHFT
            &kp ESC    &kp LALT              &mo 2  &kp SPACE  &mo 1  &kp LA(GRAVE)              &mo 3     &kp LGUI
        >;
        // Layer 0's right thumb MO(3) key exposes the Layer 3 pairing/numeric
        // fallback without changing the normal typing layer.
        //&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };

    layer_1 {
        bindings = <
            &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6    &kp N7   &kp N8   &kp N9    &kp N0 &kp DEL
            &trans    &trans &trans &trans &trans &trans           &kp PG_UP &kp HOME &mo 4    &kp END   &trans &trans
            &trans    &trans &trans &trans &trans &trans           &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &trans &trans
            &trans    &trans               &trans &trans           &trans    &trans                      &trans &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &trans  &trans    &kp MINUS &kp EQUAL &trans     &trans
            &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &kp LBKT  &kp RBKT  &kp NUBS  &trans     &trans
            &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &trans  &kp SEMI  &kp SQT   &trans    &kp QMARK  &kp BSLH
            &trans &trans                  &trans  &trans     &trans  &trans                        &trans     &trans
        >;
        //レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
        sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            // Pairing fallback: hold the default-layer MO(3) key and use the
            // right half as a numeric keypad. The rightmost bottom key is
            // ENTER for hosts that still request a passkey.
            &studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
            &trans &bt BT_CLR_ALL &bt BT_CLR &bootloader &trans &trans      &kp N7 &kp N8 &kp N9 &kp N0 &trans &trans
            &trans &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &trans
            // Hold the Layer 3 key and tap one of the left-side lower keys
            // to select the Studio endpoint. ZMK Studio requires the output
            // endpoint to match the transport used by the client.
            &out OUT_USB &out OUT_BLE               &out OUT_TOG &trans      &trans    &trans                      &trans &kp ENTER
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
