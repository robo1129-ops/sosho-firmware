diff --git a/proto/zmk/sosho.proto b/proto/zmk/sosho.proto
new file mode 100644
--- /dev/null
+++ b/proto/zmk/sosho.proto
@@ -0,0 +1,29 @@
+syntax = "proto3";
+package zmk.sosho;
+
+message Request {
+  oneof request_type {
+    bool get_sleep = 1;
+    uint32 set_sleep_timeout_ms = 2;
+  }
+}
+
+message Response {
+  oneof response_type {
+    SleepSettings get_sleep = 1;
+    SleepSettings set_sleep_timeout_ms = 2;
+    ErrorCode error = 3;
+  }
+}
+
+message SleepSettings {
+  bool enabled = 1;
+  uint32 timeout_ms = 2;
+  bool runtime_control = 3;
+}
+
+enum ErrorCode {
+  ERROR_OK = 0;
+  ERROR_BAD_ARGUMENT = 1;
+  ERROR_STORAGE = 2;
+  ERROR_NOT_SUPPORTED = 3;
+}
