diff --git a/proto/zmk/macro.proto b/proto/zmk/macro.proto
new file mode 100644
--- /dev/null
+++ b/proto/zmk/macro.proto
@@ -0,0 +1,45 @@
+syntax = "proto3";
+
+package zmk.macro;
+
+// SO-SHO runtime macro extension. This is intentionally a separate Studio
+// subsystem so standard ZMK keymap RPC messages remain wire-compatible.
+message Request {
+    oneof request_type {
+        bool list_macros = 1;
+        uint32 get_macro = 2;
+        SetMacroRequest set_macro = 3;
+        uint32 delete_macro = 4;
+        uint32 run_macro = 5;
+    }
+}
+
+message Response {
+    oneof response_type {
+        uint32 macro_ids = 1;
+        MacroData get_macro = 2;
+        bool set_macro = 3;
+        bool delete_macro = 4;
+        bool run_macro = 5;
+        ErrorCode error = 6;
+    }
+}
+
+message SetMacroRequest {
+    uint32 id = 1;
+    bytes data = 2;
+}
+
+message MacroData {
+    uint32 id = 1;
+    bytes data = 2;
+}
+
+enum ErrorCode {
+    ERROR_OK = 0;
+    ERROR_BAD_ARGUMENT = 1;
+    ERROR_NOT_FOUND = 2;
+    ERROR_NO_SPACE = 3;
+    ERROR_STORAGE = 4;
+    ERROR_BUSY = 5;
+}
