+/*
+ * Keep a marker that is written only after the physical hold-tap switch has
+ * completed a tap and has been released. The upstream quick-tap marker is
+ * also updated by generated keycode events, so it cannot safely distinguish
+ * a physical release from an emitted keycode.
+ */
+struct same_key_tap_marker {
+    int32_t position;
+    int64_t release_timestamp;
+#if IS_ENABLED(CONFIG_ZMK_SPLIT)
+    uint8_t source;
+#endif
+    bool valid;
+};
+
+static struct same_key_tap_marker same_key_tap = {
+    .position = ZMK_BHV_HOLD_TAP_POSITION_NOT_USED,
+    .release_timestamp = INT32_MIN,
+    .valid = false,
+};
+
 static void store_last_tapped(int64_t timestamp) {
     if (timestamp > last_tapped.timestamp) {
         last_tapped.position = INT32_MIN;
@@ -190,8 +211,44 @@ static bool is_same_key_recent_tap(struct active_hold_tap *hold_tap) {
     return (hold_tap->timestamp - last_tapped.timestamp) < window_ms;
 }
 
+static void remember_same_key_tap(struct active_hold_tap *hold_tap, int64_t timestamp) {
+    same_key_tap.position = hold_tap->position;
+    same_key_tap.release_timestamp = timestamp;
+#if IS_ENABLED(CONFIG_ZMK_SPLIT)
+    same_key_tap.source = hold_tap->source;
+#endif
+    same_key_tap.valid = true;
+}
+
+static bool consume_same_key_tap(struct active_hold_tap *hold_tap) {
+    if (!same_key_tap.valid || same_key_tap.position != hold_tap->position ||
+        hold_tap->timestamp < same_key_tap.release_timestamp) {
+        return false;
+    }
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT)
+    if (same_key_tap.source != hold_tap->source) {
+        return false;
+    }
+#endif
+
+    int64_t window_ms = hold_tap->config->tapping_term_ms;
+    if (hold_tap->config->quick_tap_ms > window_ms) {
+        window_ms = hold_tap->config->quick_tap_ms;
+    }
+
+    bool matches = (hold_tap->timestamp - same_key_tap.release_timestamp) < window_ms;
+    same_key_tap.valid = false;
+    return matches;
+}
+
 static bool should_resolve_quick_tap(struct active_hold_tap *hold_tap) {
 #if IS_ENABLED(CONFIG_ZMK_BEHAVIOR_HOLD_TAP_SAME_KEY_HOLD)
+    if (consume_same_key_tap(hold_tap)) {
+        LOG_DBG("%d physical same-key re-press keeps the tap binding held", hold_tap->position);
+        return true;
+    }
+
     if (is_same_key_recent_tap(hold_tap)) {
         LOG_DBG("%d same-key re-press resolves tap so the tap binding remains held",
                 hold_tap->position);
