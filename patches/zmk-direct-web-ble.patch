index 1f4da6d..cf25f8c 100644
--- a/app/src/studio/Kconfig
+++ b/app/src/studio/Kconfig
@@ -93,6 +93,21 @@ config ZMK_STUDIO_TRANSPORT_BLE_PREF_LATENCY
       When the studio UI is connected, a lower latency can be requested in order
       to make the interactions between keyboard and studio faster.
 
+config ZMK_STUDIO_TRANSPORT_BLE_DIRECT_WEB
+    bool "Keep a direct Web Bluetooth endpoint available while HID is connected"
+    default n
+    help
+      Keep connectable advertising active while a paired HID host is connected.
+      This is intended for SO-SHO firmware that is used with a browser on
+      Windows, where the HID connection otherwise makes the keyboard stop
+      advertising.  The Studio GATT characteristic is exposed without an
+      SMP pairing requirement in this mode, so a browser can open a separate
+      Studio connection without replacing the active keyboard profile.
+
+      This is an opt-in interoperability mode.  It does not change the
+      default ZMK behavior and it should only be enabled for a dedicated
+      device/editor pairing workflow.
+
 endif
 
