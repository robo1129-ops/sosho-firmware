@@ -24,10 +24,81 @@
 LOG_MODULE_DECLARE(zmk_studio, CONFIG_ZMK_STUDIO_LOG_LEVEL);
 
 static bool handling_rx = false;
+/*
+ * The upstream transport sends indications to the active HID profile.  In
+ * direct-Web mode there can be a second, unpaired Studio connection, so keep
+ * the connection that actually wrote the RPC request and reply on it.
+ */
+static struct bt_conn *studio_conn;
+static K_MUTEX_DEFINE(studio_conn_lock);
 
 static K_SEM_DEFINE(indicate_sem, 1, 1);
 static atomic_t notify_size;
 
+static void studio_conn_disconnected(struct bt_conn *conn, uint8_t reason) {
+    ARG_UNUSED(reason);
+
+    struct bt_conn *released = NULL;
+    k_mutex_lock(&studio_conn_lock, K_FOREVER);
+    if (studio_conn == conn) {
+        released = studio_conn;
+        studio_conn = NULL;
+    }
+    k_mutex_unlock(&studio_conn_lock);
+
+    if (released) {
+        bt_conn_unref(released);
+    }
+}
+
+BT_CONN_CB_DEFINE(studio_rpc_conn_callbacks) = {
+    .disconnected = studio_conn_disconnected,
+};
+
+static void remember_studio_conn(struct bt_conn *conn) {
+    if (!IS_ENABLED(CONFIG_ZMK_STUDIO_TRANSPORT_BLE_DIRECT_WEB) || !conn) {
+        return;
+    }
+
+    struct bt_conn *released = NULL;
+    k_mutex_lock(&studio_conn_lock, K_FOREVER);
+    if (studio_conn != conn) {
+        released = studio_conn;
+        studio_conn = bt_conn_ref(conn);
+    }
+    k_mutex_unlock(&studio_conn_lock);
+
+    if (released) {
+        bt_conn_unref(released);
+    }
+}
+
+static void clear_studio_conn(void) {
+    struct bt_conn *released = NULL;
+    k_mutex_lock(&studio_conn_lock, K_FOREVER);
+    released = studio_conn;
+    studio_conn = NULL;
+    k_mutex_unlock(&studio_conn_lock);
+
+    if (released) {
+        bt_conn_unref(released);
+    }
+}
+
+static struct bt_conn *get_studio_conn(void) {
+    struct bt_conn *conn = NULL;
+
+    if (IS_ENABLED(CONFIG_ZMK_STUDIO_TRANSPORT_BLE_DIRECT_WEB)) {
+        k_mutex_lock(&studio_conn_lock, K_FOREVER);
+        if (studio_conn) {
+            conn = bt_conn_ref(studio_conn);
+        }
+        k_mutex_unlock(&studio_conn_lock);
+    }
+
+    return conn ? conn : zmk_ble_active_profile_conn();
+}
