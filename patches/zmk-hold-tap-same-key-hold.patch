+/*
+ * SO-SHO uses the physical-key interpretation users expect from a normal
+ * switch: tap, release, then press the same key again and keep it down means
+ * that the second press is held.  Upstream quick-tap intentionally resolves
+ * this sequence as another tap, which is useful for some keymaps but prevents
+ * a real key-down from reaching the host for hold-tap bindings.
+ */
+static bool is_same_key_recent_tap(struct active_hold_tap *hold_tap) {
+    if (last_tapped.position != hold_tap->position ||
+        hold_tap->timestamp < last_tapped.timestamp) {
+        return false;
+    }
+
+#if IS_ENABLED(CONFIG_ZMK_SPLIT)
+    /* A matrix position is local to each half. Never match a tap from the
+     * other half as the same physical key. */
+    if (last_tapped.source != hold_tap->source) {
+        return false;
+    }
+#endif
+
+    int64_t window_ms = hold_tap->config->tapping_term_ms;
+    if (hold_tap->config->quick_tap_ms > window_ms) {
+        window_ms = hold_tap->config->quick_tap_ms;
+    }
+
+    return (hold_tap->timestamp - last_tapped.timestamp) < window_ms;
+}

+static bool should_resolve_quick_tap(struct active_hold_tap *hold_tap) {
+#if IS_ENABLED(CONFIG_ZMK_BEHAVIOR_HOLD_TAP_SAME_KEY_HOLD)
+    if (is_same_key_recent_tap(hold_tap)) {
+        LOG_DBG("%d same-key re-press resolves tap so the tap binding remains held",
+                hold_tap->position);
+        return true;
+    }
+#endif
+
+    return is_quick_tap(hold_tap);
+}
