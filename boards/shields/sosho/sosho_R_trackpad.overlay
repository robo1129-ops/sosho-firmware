#include "sosho_R.dtsi"

/* Alternate central variant: RIGHT is the central trackpad side. */
&spi0 { status = "okay"; };
&glidepoint {
    status = "okay";
    invert-y;
    data-mode = "absolute";
    clipping-enable;
    scaling-enable;
    scaling-x-resolution = <2048>;
    scaling-y-resolution = <1536>;
};
&glidepoint_listener {
    status = "okay";
    input-processors = <&sosho_trackpad_edge_scroll>,
                       <&sosho_trackpad_long_press>,
                       <&zip_xy_scaler SOSHO_TRACKPAD_XY_SCALE_NUM SOSHO_TRACKPAD_XY_SCALE_DEN>;
};

/* The central can also receive the left peripheral's trackpad input. */
&glidepoint_split { status = "okay"; };
&glidepoint_split_listener {
    status = "okay";
    /* Split ABS->REL conversion is performed on the source half. */
    input-processors = <&sosho_trackpad_long_press>,
                       <&zip_xy_scaler SOSHO_TRACKPAD_XY_SCALE_NUM SOSHO_TRACKPAD_XY_SCALE_DEN>;
};

/* Keep the alternate left-trackball combination available. */
&trackball_split { status = "okay"; };
&trackball_split_listener {
    status = "okay";
    input-processors = <&zip_xy_scaler SOSHO_TRACKBALL_XY_SCALE_NUM SOSHO_TRACKBALL_XY_SCALE_DEN>;
};
