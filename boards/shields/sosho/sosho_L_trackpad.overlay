#include "sosho_L.dtsi"

&spi0 { status = "okay"; };
&glidepoint {
    status = "okay";
    invert-x;
    data-mode = "absolute";
    clipping-enable;
    scaling-enable;
    scaling-x-resolution = <2048>;
    scaling-y-resolution = <1536>;
    /* 1x is the official maximum sensitivity. Keep the raw movement rate
     * while validating the hardware and avoid attenuating small motion. */
    sensitivity = "1x";
};
&glidepoint_split {
    status = "okay";
    device = <&glidepoint>;
    input-processors = <&sosho_trackpad_edge_scroll>;
};
