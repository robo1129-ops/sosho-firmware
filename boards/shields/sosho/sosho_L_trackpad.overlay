#include "sosho_L.dtsi"

&spi0 { status = "okay"; };
&glidepoint {
    status = "okay";
    invert-x;
    /* The physical pad orientation reports vertical motion inverted. */
    invert-y;
    /* Absolute samples let the SO-SHO input processor distinguish normal
     * pointer movement from the outer-ring scroll gesture. */
    data-mode = "absolute";
    clipping-enable;
    active-range-x-min = <128>;
    active-range-x-max = <1920>;
    active-range-y-min = <64>;
    active-range-y-max = <1472>;
    sensitivity = "1x";
};
&glidepoint_split {
    status = "okay";
    device = <&glidepoint>;
};
