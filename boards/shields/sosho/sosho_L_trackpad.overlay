#include "sosho_L.dtsi"

&spi0 { status = "okay"; };
&glidepoint {
    status = "okay";
    invert-x;
    /* 1x is the official maximum sensitivity. Keep the raw movement rate
     * while validating the hardware and avoid attenuating small motion. */
    sensitivity = "1x";
};
&glidepoint_split {
    status = "okay";
    device = <&glidepoint>;
};
