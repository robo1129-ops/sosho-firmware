#include "sosho_L.dtsi"

&spi0 { status = "okay"; };
&glidepoint {
    status = "okay";
    invert-x;
    /* Use the official relative mode. This keeps movement on the standard
     * ZMK input path and avoids losing the trackpad when the split link is
     * active. Primary taps remain enabled by the shared shield definition. */
    data-mode = "relative";
    sensitivity = "1x";
};
&glidepoint_split {
    status = "okay";
    device = <&glidepoint>;
};
