#include "sosho_R.dtsi"

/*
 * Daily variant: RIGHT is the central trackball side.
 * SOSHO_TRACKBALL_XY_SCALE_* is a build-time rational scale for both axes.
 * The input processors are source-verified ZMK pointing processors.
 */
&spi1 { status = "okay"; };
&trackball { status = "okay"; };
&trackball_listener {
    status = "okay";
    /* Correct the sensor orientation on both axes, then apply the 3/4 scale. */
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
                       <&zip_xy_scaler SOSHO_TRACKBALL_XY_SCALE_NUM SOSHO_TRACKBALL_XY_SCALE_DEN>;
};

/* The central receives the left peripheral's trackpad input here. */
&glidepoint_split { status = "okay"; };
&glidepoint_split_listener {
    status = "okay";
    /* Keep the left peripheral's trackpad path explicit on the central side.
     * Trackpad movement remains at the independent 1/1 setting. */
    input-processors = <&zip_xy_scaler SOSHO_TRACKPAD_XY_SCALE_NUM SOSHO_TRACKPAD_XY_SCALE_DEN>;
};

/* Keep the alternate left-trackball combination available. */
&trackball_split { status = "okay"; };
&trackball_split_listener {
    status = "okay";
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
                       <&zip_xy_scaler SOSHO_TRACKBALL_XY_SCALE_NUM SOSHO_TRACKBALL_XY_SCALE_DEN>;
};
